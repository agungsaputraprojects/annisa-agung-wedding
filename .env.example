# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_…) atau "anon public key" — keduanya aman dipakai di browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional: tampilkan contoh ucapan tanpa Supabase (hanya untuk mencoba tampilan, tidak tersimpan)
# NEXT_PUBLIC_WISHES_DEMO=1

# Domain undangan, untuk gambar preview link (Open Graph)
NEXT_PUBLIC_SITE_URL=https://undangan-anda.vercel.app
